{
  "name": "gulp-nunjucks-starter-kit",
  "version": "1.0.3",
  "description": "Architecture-first Starter Kit focused on maintainable frontend development with Nunjucks.",
  "main": "gulpfile.mjs",
  "scripts": {
    "eslint:status": "npx eslint",
    "eslint:fixesAll": "npx eslint . --fix",
    "dev": "gulp",
    "build": "gulp build --build",
    "build:archive:tgz": "gulp build --build && npx nsk-tools create archive -o tgz -p build",
    "build:archive:tar": "gulp build --build && npx nsk-tools create archive -o tar -p build",
    "build:archive:zip": "gulp build --build && npx nsk-tools create archive -o zip -p build",
    "ncu": "ncu",
    "ncu:interactive": "ncu --interactive",
    "ncu:interactive:formatgroup": "ncu --interactive --format group",
    "sass:migrator": "sass-migrator",
    "sass:migrator:imports": "sass-migrator module --load-path --migrate-deps ./src/styles/**/*.scss ./src/views/components/**/*.scss",
    "cleanCache:webpack": "rm -rvf node_modules/.cache/webpack"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "browserslist": {
    "stylesheets": [
      "> 0.1% in GB and not dead",
      "last 6 Chrome versions",
      "last 6 Firefox versions",
      "last 6 Edge versions",
      "last 2 Samsung versions",
      "Firefox ESR",
      "Safari >= 11",
      "iOS >= 11",
      "ie 11"
    ],
    "javascripts": [
      "supports es6-module"
    ],
    "modern": [
      "last 1 chrome version",
      "last 1 firefox version"
    ],
    "node": [
      "node 22"
    ]
  },
  "os": [
    "darwin",
    "linux",
    "win64",
    "!win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Template-Craft/gulp-nunjucks-starter-kit.git"
  },
  "keywords": [
    "gulp",
    "nunjucks",
    "scss",
    "babel",
    "es6"
  ],
  "author": {
    "name": "NИ",
    "email": "galaxyrobotix@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Template-Craft/gulp-nunjucks-starter-kit/issues"
  },
  "homepage": "https://github.com/Template-Craft/gulp-nunjucks-starter-kit#readme",
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/register": "^8.1.2",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.6.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "browser-sync": "^3.0.4",
    "chalk": "^6.0.1",
    "cssnano": "^9.9.0",
    "cssnano-preset-advanced": "^10.0.0",
    "del": "^9.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-es-x": "^10.1.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.14.0",
    "gulp": "^5.0.1",
    "gulp-beautify": "^3.0.0",
    "gulp-if": "^3.0.0",
    "gulp-newer": "^1.4.0",
    "gulp-nunjucks-render": "^2.2.3",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^6.0.1",
    "node-notifier": "^12.1.0",
    "pidusage": "^4.1.0",
    "postcss": "^8.5.32",
    "postcss-sort-media-queries": "^6.7.1",
    "prettier": "3.10.1",
    "sass": "^1.108.2",
    "webpack": "^5.112.2",
    "webpack-stream": "^7.0.0"
  },
  "dependencies": {
    "core-js": "^3.51.0",
    "normalize.css": "^8.0.1",
    "rfs": "^10.0.0"
  },
  "optionalDependencies": {
    "@eslint/migrate-config": "^3.0.3",
    "npm-check-updates": "^23.1.1",
    "sass-migrator": "^2.7.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "core-js@3.51.0": true
  }
}
