{
  "name": "gulp-nunjucks-starter-kit",
  "version": "1.0.3",
  "description": "Инструмент для компонентного проектирования статических сайтов, как lending page так и много-страничных проектов.",
  "main": "gulpfile.mjs",
  "scripts": {
    "eslint:init": "npm init @eslint/config@latest",
    "dev": "gulp",
    "build": "gulp build --build",
    "build:archive:tgz": "gulp build --build && npx nsk-tools create archive -o tgz -p build",
    "build:archive:tar": "gulp build --build && npx nsk-tools create archive -o tar -p build",
    "build:archive:zip": "gulp build --build && npx nsk-tools create archive -o zip -p build",
    "ncu": "ncu",
    "ncu:interactive": "ncu --interactive",
    "ncu:interactive:formatgroup": "ncu --interactive --format group",
    "sass:migrator": "sass-migrator",
    "sass:migrator:imports": "sass-migrator module --load-path --migrate-deps ./src/styles/**/*.scss ./src/views/components/**/*.scss"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "browserslist": {
    "stylesheets": [
      "> 0.1% in GB and not dead",
      "last 6 Chrome versions",
      "last 6 Firefox versions",
      "last 6 Edge versions",
      "last 2 Samsung versions",
      "Firefox ESR",
      "Safari >= 11",
      "iOS >= 11",
      "ie 11"
    ],
    "javascripts": [
      "supports es6-module"
    ],
    "modern": [
      "last 1 chrome version",
      "last 1 firefox version"
    ],
    "node": [
      "node 20"
    ]
  },
  "os": [
    "darwin",
    "linux",
    "win64",
    "!win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Template-Craft/gulp-nunjucks-starter-kit.git"
  },
  "keywords": [
    "gulp",
    "nunjucks",
    "scss",
    "babel",
    "es6"
  ],
  "author": {
    "name": "NИ",
    "email": "galaxyrobotix@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Template-Craft/gulp-nunjucks-starter-kit/issues"
  },
  "homepage": "https://github.com/Template-Craft/gulp-nunjucks-starter-kit#readme",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/register": "^8.0.1",
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@types/gulp": "^4.0.18",
    "@types/gulp-clean-css": "^4.3.4",
    "@types/gulp-plumber": "^0.0.37",
    "@types/gulp-postcss": "^8.0.6",
    "@types/gulp-rename": "^2.0.7",
    "@types/node-notifier": "^8.0.5",
    "@types/webpack-stream": "^3.2.16",
    "autoprefixer": "^10.4.27",
    "babel-loader": "^10.0.0",
    "browser-sync": "^3.0.4",
    "chalk": "^5.6.2",
    "cssnano": "^7.1.3",
    "cssnano-preset-advanced": "^7.0.11",
    "del": "^8.0.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-es-x": "^8.7.0",
    "eslint-plugin-n": "^17.20.0",
    "eslint-plugin-promise": "^7.2.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.4.0",
    "gulp": "^5.0.1",
    "gulp-beautify": "^3.0.0",
    "gulp-if": "^3.0.0",
    "gulp-newer": "^1.4.0",
    "gulp-nunjucks-render": "^2.2.3",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-replace": "^1.1.4",
    "gulp-sass": "^6.0.1",
    "node-notifier": "^10.0.1",
    "pidusage": "^4.0.1",
    "postcss": "^8.5.16",
    "postcss-sort-media-queries": "^6.3.3",
    "prettier": "3.8.1",
    "sass": "^1.98.0",
    "webpack": "^5.105.4",
    "webpack-stream": "^7.0.0"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "normalize.css": "^8.0.1",
    "rfs": "^10.0.0"
  },
  "optionalDependencies": {
    "@eslint/migrate-config": "^1.5.2",
    "npm-check-updates": "^19.6.5",
    "sass-migrator": "^2.5.7"
  }
}
